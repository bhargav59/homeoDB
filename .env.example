# ─── LLM Configuration ───────────────────────────────────────────────────────
# Pick ONE of the following LLM backends:

# Option 1: OpenAI (cloud)
OPENAI_API_KEY=your_openai_key_here
LLM_MODEL=gpt-4o-mini

# Option 2: Ollama (local, free)
# Uncomment the two lines below and comment out the OpenAI lines above.
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

# ─── Proxy Configuration (optional) ─────────────────────────────────────────
# Used by the Node.js browser agent for anti-detection.
# Supports HTTP, HTTPS, and SOCKS5 proxies.
# PROXY_URL=http://username:password@proxy.example.com:8080

# ─── Notes ───────────────────────────────────────────────────────────────────
# If NEITHER OpenAI nor Ollama is configured, the engine will fall back to
# a rule-based extractor that works without any LLM (lower quality but free).
